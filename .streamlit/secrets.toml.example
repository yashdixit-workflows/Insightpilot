# INSTRUCTIONS: Do NOT commit this file to GitHub.
# Add these secrets in Streamlit Cloud under:
#   App Settings → Secrets
#
# Paste the content below into the Streamlit Cloud secrets editor:

GOOGLE_API_KEY = "your-google-api-key-here"

# ── Microsoft Fabric Lakehouse (optional) ──────────────────────────────
# Required only if you enable the Fabric SQL connector feature.
FABRIC_SERVER   = "your-fabric-sql-endpoint.datawarehouse.fabric.microsoft.com"
FABRIC_DATABASE = "your-lakehouse-or-warehouse-name"
FABRIC_USERNAME = "your-aad-email@domain.com"
FABRIC_PASSWORD = "your-aad-password"
