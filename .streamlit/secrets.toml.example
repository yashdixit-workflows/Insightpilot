# INSTRUCTIONS: Do NOT commit this file to GitHub.
# Add these secrets in Streamlit Cloud under:
#   App Settings → Secrets
#
# Paste the content below into the Streamlit Cloud secrets editor:

# ── Google Gemini API ──────────────────────────────────────────────────
GOOGLE_API_KEY = "your-google-api-key-here"

# ── Microsoft Fabric SQL Connector ────────────────────────────────────
# Uses Azure AD Service Principal (app-only) auth — more secure than
# username/password and works on any cloud host including Streamlit Cloud.
#
# How to get these values:
#   1. Go to Azure Portal → Microsoft Entra ID → App registrations
#   2. Click "New registration" → name it e.g. "InsightPilot-Fabric"
#   3. After creating: copy the Application (client) ID → FABRIC_CLIENT_ID
#   4. Go to Certificates & Secrets → New client secret → copy value → FABRIC_CLIENT_SECRET
#   5. Copy your Directory (tenant) ID → FABRIC_TENANT_ID
#   6. In Fabric workspace → Settings → grant the app "Contributor" role
#   7. FABRIC_SERVER  = your SQL Analytics Endpoint (found in Fabric workspace settings)
#   8. FABRIC_DATABASE = your Lakehouse or Warehouse name

FABRIC_SERVER        = "abc123xyz.datawarehouse.fabric.microsoft.com"
FABRIC_DATABASE      = "your-lakehouse-name"
FABRIC_TENANT_ID     = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
FABRIC_CLIENT_ID     = "yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"
FABRIC_CLIENT_SECRET = "your~client~secret~value~here"
